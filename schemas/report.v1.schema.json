{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r3oof-900/darb/schemas/report.v1.schema.json",
  "title": "darb report (darb-report/v1)",
  "description": "The document every darb output format renders (pkg/schema). Fields are only added within a major version; every object is closed, so a field this schema does not describe fails validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool", "threat_model", "summary", "findings", "intended_access", "coverage", "graph", "rules", "exit_code"],
  "properties": {
    "schema": {"const": "darb-report/v1"},
    "tool": {"$ref": "#/$defs/tool"},
    "generated_at": {"description": "When the report was made (RFC 3339, UTC); only with --timestamps.", "type": "string", "format": "date-time"},
    "inputs": {"description": "What was scanned, each with the SHA-256 of what was read.", "type": "array", "items": {"$ref": "#/$defs/scannedInput"}},
    "executive_summary": {"$ref": "#/$defs/explanation"},
    "threat_model": {"$ref": "#/$defs/threatModel"},
    "summary": {"$ref": "#/$defs/summary"},
    "findings": {"type": ["array", "null"], "items": {"$ref": "#/$defs/finding"}},
    "intended_access": {"type": ["array", "null"], "items": {"$ref": "#/$defs/intendedAccess"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "graph": {"$ref": "#/$defs/graph"},
    "rules": {"type": ["array", "null"], "items": {"$ref": "#/$defs/rule"}},
    "suppressed": {"description": "Findings a .darb-ignore.yaml suppression silences until it expires; not in findings, not counted for the exit code.", "type": "array", "items": {"$ref": "#/$defs/suppressedFinding"}},
    "expired_suppressions": {"description": "Suppressions past their expiry date: their findings, when still present, are in findings again.", "type": "array", "items": {"$ref": "#/$defs/expiredSuppression"}},
    "baseline": {"$ref": "#/$defs/baseline"},
    "exit_code": {"description": "0 clean, 1 findings at or above fail_on, 2 usage or configuration error, 3 incomplete scan, 4 internal error.", "enum": [0, 1, 2, 3, 4]}
  },
  "$defs": {
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "commit", "rule_catalog_version", "information_uri"],
      "properties": {
        "name": {"const": "darb"},
        "version": {"type": "string"},
        "commit": {"type": "string"},
        "rule_catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "information_uri": {"type": "string"}
      }
    },
    "threatModel": {
      "type": "object", "additionalProperties": false,
      "required": ["assume_compromised", "fail_on"],
      "properties": {
        "assume_compromised": {"type": "boolean"},
        "fail_on": {"$ref": "#/$defs/severity"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["findings", "by_severity", "unconfirmed", "confirmed_unless_denied"],
      "properties": {
        "findings": {"type": "integer", "minimum": 0},
        "by_severity": {
          "type": ["object", "null"],
          "propertyNames": {"$ref": "#/$defs/severity"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "unconfirmed": {"description": "Findings that need an unknown allow (DESIGN.md 6.2).", "type": "integer", "minimum": 0},
        "confirmed_unless_denied": {"description": "Findings whose only UNKNOWNs are possible Denies.", "type": "integer", "minimum": 0}
      }
    },
    "location": {
      "description": "A file and lines, or an ARN and the API call that returned it.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 0},
        "end_line": {"type": "integer", "minimum": 0},
        "address": {"type": "string"},
        "arn": {"type": "string"},
        "api": {"type": "string"}
      }
    },
    "factors": {
      "description": "The score's factors, per mille (SCORING.md).",
      "type": "object", "additionalProperties": false,
      "required": ["confidence"],
      "properties": {
        "exposure": {"type": "integer", "minimum": 0, "maximum": 1000},
        "hops": {"type": "integer", "minimum": 0, "maximum": 1000},
        "preconditions": {"type": "integer", "minimum": 0, "maximum": 1000},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 1000},
        "likelihood": {"type": "integer", "minimum": 0, "maximum": 1000},
        "classification": {"type": "integer", "minimum": 0, "maximum": 1000},
        "blast_radius": {"type": "integer", "minimum": 0, "maximum": 1000},
        "impact": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "fixStep": {
      "description": "One change that breaks one edge, or (resolve) the unknown to decide first (SCORING.md 4).",
      "type": "object", "additionalProperties": false,
      "required": ["edge", "side", "fix_kind", "policy", "cost"],
      "properties": {
        "edge": {"type": "string"},
        "side": {"enum": ["identity", "resource", "trust", "workload", "rbac", "mapping", "node", "exposure"]},
        "fix_kind": {"description": "narrow: make a broad grant specific; revoke: remove an explicit grant or detach an AWS managed policy (confirm it is not needed); resolve: decide an unknown grant first (cost 0, no patch).", "enum": ["narrow", "revoke", "resolve"]},
        "policy": {"type": "string"},
        "cost": {"description": "0 only for a resolve step.", "type": "integer", "minimum": 0},
        "resolve": {"description": "For a resolve step: the command that decides it.", "type": "string"}
      }
    },
    "hop": {
      "description": "One edge of a path, with both ends and how the cheapest fix treats it.",
      "type": "object", "additionalProperties": false,
      "required": ["kind", "from", "to", "from_kind", "to_kind"],
      "properties": {
        "kind": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "from_kind": {"type": "string"},
        "to_kind": {"type": "string"},
        "cut": {"enum": ["cut", "resolve"]},
        "parts": {"description": "What a derived read stands for: the read, the decrypt, the key protecting the data.", "type": "array", "items": {"$ref": "#/$defs/hop"}}
      }
    },
    "explanation": {
      "description": "A finding or the report in plain words (scan --llm). ai_generated: written by an LLM provider; it never changes a verdict, a score or a fix. Otherwise template text, and note says why.",
      "type": "object", "additionalProperties": false,
      "required": ["summary", "ai_generated"],
      "properties": {
        "summary": {"type": "string"},
        "attack": {"type": "string"},
        "fix": {"type": "string"},
        "ai_generated": {"type": "boolean"},
        "model": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "scannedInput": {
      "description": "One input of the scan and the SHA-256 of what was read.",
      "type": "object", "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"enum": ["terraform-dir", "terraform-plan", "k8s-manifests", "aws-snapshot", "aws-live", "k8s-live"]},
        "path": {"type": "string"},
        "cluster": {"type": "string"},
        "accounts": {"type": "array", "items": {"type": "string"}},
        "regions": {"type": "array", "items": {"type": "string"}},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "remediation": {
      "description": "A finding's verified fixes (scan --fixes), in output order (DESIGN.md 9.2).",
      "type": "object", "additionalProperties": false,
      "required": ["fixes"],
      "properties": {
        "fixes": {"type": ["array", "null"], "items": {"$ref": "#/$defs/fix"}},
        "note": {"type": "string"},
        "pending": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "no_fix_within_constraints": {"type": "boolean"}
      }
    },
    "fix": {
      "description": "One strategy: its changes, both verifications and the patch.",
      "type": "object", "additionalProperties": false,
      "required": ["fix_strategy", "changes", "verified_in_memory", "verified_on_patched_files"],
      "properties": {
        "fix_strategy": {"enum": ["root-cause", "mitigation"]},
        "suggestion": {"type": "string"},
        "changes": {"type": ["array", "null"], "items": {"$ref": "#/$defs/change"}},
        "verified_in_memory": {"type": "boolean"},
        "verified_on_patched_files": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "pending": {"type": "string"},
        "diff": {"type": "string"},
        "todo": {"type": "array", "items": {"type": "string"}},
        "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["edge", "side", "fix_kind", "cost"],
      "properties": {
        "edge": {"type": "string"},
        "side": {"type": "string"},
        "fix_kind": {"type": "string"},
        "cost": {"type": "integer", "minimum": 0},
        "why": {"type": "string"},
        "todo": {"type": "string"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "note": {"type": "string"},
        "document": {"type": "string"}
      }
    },
    "findingRef": {
      "description": "A path finding, by rule, entry and jewel.",
      "type": "object", "additionalProperties": false,
      "required": ["rule", "entry", "jewel"],
      "properties": {
        "rule": {"type": "string"},
        "entry": {"type": "string"},
        "jewel": {"type": "string"}
      }
    },
    "uncuttableEdge": {
      "description": "An underlying edge of a cut derived read that no single change breaks.",
      "type": "object", "additionalProperties": false,
      "required": ["edge", "reason"],
      "properties": {
        "edge": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "default": {
      "description": "A documented default a finding relies on (DESIGN.md 4.7).",
      "type": "object", "additionalProperties": false,
      "required": ["key", "setting", "value", "value_source", "reference"],
      "properties": {
        "key": {"type": "string"},
        "setting": {"type": "string"},
        "value": {"type": "string"},
        "value_source": {"const": "default"},
        "reference": {"type": "string"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "rule_version", "kind", "title", "severity", "score", "factors", "confirmed", "status", "confidence", "defaults_used", "fingerprint"],
      "properties": {
        "rule": {"type": "string", "pattern": "^DARB-(PATH|POST)-[0-9]{3}$"},
        "rule_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"enum": ["path", "posture"]},
        "title": {"type": "string"},
        "severity": {"$ref": "#/$defs/severity"},
        "score": {"type": "integer", "minimum": 0, "maximum": 1000},
        "factors": {"$ref": "#/$defs/factors"},
        "confirmed": {"description": "status is confirmed.", "type": "boolean"},
        "status": {"description": "DESIGN.md 6.2. The severity is the worst case of every UNKNOWN, whatever the status.", "enum": ["confirmed", "confirmed_unless_denied", "unconfirmed"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "undecided": {"description": "For an unconfirmed path: what would decide it (a context key to assume, a value a plan resolves, a precondition to state).", "type": "array", "items": {"type": "string"}},
        "entry": {"description": "Path findings: the entry point's canonical identity.", "type": "string"},
        "jewel": {"description": "Path findings: the crown jewel.", "type": "string"},
        "jewel_classification": {"description": "Path findings: the jewel's classification; unclassified for a data store no rule classifies.", "type": "string"},
        "resource": {"description": "Posture findings: the resource.", "type": "string"},
        "path": {"type": "array", "items": {"type": "string"}},
        "paths_found": {"type": "integer", "minimum": 0},
        "paths_truncated": {"type": "boolean"},
        "chokepoints": {"description": "The cut: the cheapest edges whose removal breaks every path.", "type": "array", "items": {"type": "string"}},
        "cut_cost": {"type": "integer", "minimum": 0},
        "no_fix_within_constraints": {"type": "boolean"},
        "alternative_fix": {"description": "For a cut derived read (CAN_READ_PLAINTEXT): the other underlying edge, whatever its cost.", "type": "array", "items": {"type": "string"}},
        "fix": {"description": "The side the cut chose for each chokepoint edge (its cheapest fix).", "type": "array", "items": {"$ref": "#/$defs/fixStep"}},
        "other_side_fix": {"description": "The other sides that also break a chokepoint edge, dearer.", "type": "array", "items": {"$ref": "#/$defs/fixStep"}},
        "alternative_fix_detail": {"description": "The cheapest fix of each alternative_fix edge.", "type": "array", "items": {"$ref": "#/$defs/fixStep"}},
        "shared_fix_possible": {"description": "Resources or policies one change to which breaks two or more chokepoint edges.", "type": "array", "items": {"type": "string"}},
        "worst_case_path": {"description": "A less certain path of the same rule that scores higher than path; the severity is its score.", "type": "array", "items": {"type": "string"}},
        "remediation": {"$ref": "#/$defs/remediation"},
        "explanation": {"$ref": "#/$defs/explanation"},
        "hops": {"description": "path as edges with both ends.", "type": "array", "items": {"$ref": "#/$defs/hop"}},
        "branches": {"description": "cut edges off path (an escalation of a dominated path merged into this cut), each followed by the edge to the jewel.", "type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/hop"}}},
        "worst_case_hops": {"description": "worst_case_path as edges with both ends.", "type": "array", "items": {"$ref": "#/$defs/hop"}},
        "also_fixes": {"description": "Path findings of other rules this cut also fixes (path findings only).", "type": "array", "items": {"$ref": "#/$defs/findingRef"}},
        "uncuttable": {"description": "Underlying edges of a cut derived read that no single change breaks (path findings only).", "type": "array", "items": {"$ref": "#/$defs/uncuttableEdge"}},
        "remediation_status": {"description": "complete, or partial_pending_resolution when the cut has a resolve step: decide the unknowns, then rescan.", "enum": ["complete", "partial_pending_resolution"]},
        "defaults_used": {"type": ["array", "null"], "items": {"$ref": "#/$defs/default"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "location": {"$ref": "#/$defs/location"},
        "fingerprint": {"description": "sha256 of the rule, its major version and the entry and jewel (or the resource): the problem, not its fix.", "type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "path"}}}, "then": {"required": ["entry", "jewel"]}},
        {"if": {"properties": {"kind": {"const": "posture"}}}, "then": {"required": ["resource"]}}
      ]
    },
    "intendedAccess": {
      "type": "object", "additionalProperties": false,
      "required": ["principal", "action", "resource", "status"],
      "properties": {
        "principal": {"type": "string"},
        "action": {"type": "string"},
        "resource": {"type": "string"},
        "status": {"enum": ["verified", "unconfirmed", "not-satisfied", "not-modelled"]},
        "detail": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["collected", "gaps_over_tolerance", "gaps", "notes"],
      "properties": {
        "collected": {"description": "Inputs that produced data; 0 means nothing was scanned (exit 3), never a clean result.", "type": "integer", "minimum": 0},
        "gaps_over_tolerance": {"type": "integer", "minimum": 0},
        "gaps": {"type": ["array", "null"], "items": {"$ref": "#/$defs/gap"}},
        "notes": {"type": ["array", "null"], "items": {"$ref": "#/$defs/note"}}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "detail"],
      "properties": {
        "kind": {"type": "string"},
        "source": {"type": "string"},
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 0},
        "address": {"type": "string"},
        "account": {"type": "string"},
        "api": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "note": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "subject", "detail"],
      "properties": {
        "kind": {"type": "string"},
        "subject": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["nodes", "edges", "entry_jewel_pairs"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0},
        "entry_jewel_pairs": {"type": "integer", "minimum": 0}
      }
    },
    "suppressedFinding": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "rule", "severity", "reason", "owner", "expires"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rule": {"type": "string", "pattern": "^DARB-(PATH|POST)-[0-9]{3}$"},
        "severity": {"$ref": "#/$defs/severity"},
        "entry": {"type": "string"},
        "jewel": {"type": "string"},
        "resource": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"}
      }
    },
    "expiredSuppression": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "reason", "owner", "expires", "fires"],
      "properties": {
        "fingerprint": {"type": "string"},
        "reason": {"type": "string"},
        "owner": {"type": "string"},
        "expires": {"type": "string", "format": "date"},
        "fires": {"description": "The finding is still present and reported again.", "type": "boolean"}
      }
    },
    "baseline": {
      "description": "The comparison with --baseline: findings lists only the new findings.",
      "type": "object", "additionalProperties": false,
      "required": ["file", "unchanged", "new", "resolved"],
      "properties": {
        "file": {"type": "string"},
        "unchanged": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0},
        "resolved": {"type": "array", "items": {"$ref": "#/$defs/resolvedItem"}}
      }
    },
    "resolvedItem": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "rule"],
      "properties": {
        "fingerprint": {"type": "string"},
        "rule": {"type": "string"},
        "entry": {"type": "string"},
        "jewel": {"type": "string"},
        "resource": {"type": "string"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "kind", "title", "rationale", "attack_techniques", "references"],
      "properties": {
        "id": {"type": "string", "pattern": "^DARB-(PATH|POST)-[0-9]{3}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"enum": ["path", "posture"]},
        "title": {"type": "string"},
        "rationale": {"type": "string"},
        "attack_techniques": {"type": ["array", "null"], "items": {"type": "string"}},
        "references": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    }
  }
}
